{
  "name": "sim88",
  "version": "0.2.0",
  "private": true,
  "description": "Educational simulator of a simplified Intel 8088, in the browser.",
  "license": "MIT",
  "author": "Federico Sawady",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sawady/sim88.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {

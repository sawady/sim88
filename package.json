    "redux-thunk": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "peggy": "^5.1.1",
    "typescript": "^7.0.2",

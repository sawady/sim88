			      1	; MOV with every MSX88 addressing mode: immediat
				e, register, direct,
			      2	; indirect through BX, and immediate to memory (
				with and without PTR).
			      3	        ORG 1000H
 1000 12		      4	B1      DB 12H
 1001 12		      5	B2      DB ?
 1002 56 34		      6	W1      DW 3456H
 1004 56 34		      7	W2      DW ?
 1006 01 02 03 04	      8	TABLA   DB 1, 2, 3, 4
			      9	        ORG 2000H
 2000 B0 0A		     10	        MOV AL, 0AH
 2002 B4 0B		     11	        MOV AH, 0BH
 2004 BB 34 12		     12	        MOV BX, 1234H
 2007 8B CB		     13	        MOV CX, BX
 2009 8A D0		     14	        MOV DL, AL
 200B 8A F4		     15	        MOV DH, AH
 200D 8A 06 00 10	     16	        MOV AL, B1          ; direct, byte
 2011 88 06 01 10	     17	        MOV B2, AL
 2015 8B 0E 02 10	     18	        MOV CX, W1          ; direct, word
 2019 89 0E 04 10	     19	        MOV W2, CX
 201D BB 06 10		     20	        MOV BX, OFFSET TABLA
 2020 8A 07		     21	        MOV AL, [BX]        ; indirect, byte
 2022 8A E0		     22	        MOV AH, AL
 2024 88 27		     23	        MOV [BX], AH
 2026 8B 17		     24	        MOV DX, [BX]        ; indirect, word

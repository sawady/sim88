			      6	        ORG 1000H
 1000 41 52 51 55 49 54	      7	MSG     DB "ARQUITECTURA"
 1006 45 43 54 55 52 41
 100C 41		      8	FIN     DB ?
			      9	        ORG 2000H
 2000 B0 FD		     10	        MOV AL, 11111101B

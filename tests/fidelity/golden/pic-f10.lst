 ÚDir.ÚCodigo maquina	 Linea¿	ÚCodigo en lenguaje ensamble

			      1	;; sim88: f10@2000 f10@4000
			      2	;; keys: 2:f10 2:f10
			      3	;; timeout: 12
			      4	; Configuration 0: F10 interrupts through INT0 o
				f the PIC with vector 10h.
			      5	; The routine counts and keeps the PIC registers
				 it sees.
			      6	        ORG 1000H
 1000 00		      7	CUENTA  DB 0
 1001 00 00 00		      8	EN_RUT  DB 0, 0, 0
			      9	        ORG 40H
 0040 00 30		     10	        DW RUT
			     11	        ORG 3000H
 3000 50		     12	RUT:    PUSH AX
 3001 E4 23		     13	        IN AL, 23H          ; ISR inside the rou
				tine
 3003 88 06 01 10	     14	        MOV EN_RUT, AL
 3007 E4 22		     15	        IN AL, 22H          ; IRR
 3009 88 06 02 10	     16	        MOV EN_RUT + 1, AL
 300D 9C		     17	        PUSHF
 300E 58		     18	        POP AX
 300F 88 26 03 10	     19	        MOV EN_RUT + 2, AH  ; flags inside (I?)
 3013 FE 06 00 10	     20	        INC CUENTA
 3017 B0 20		     21	        MOV AL, 20H
 3019 E6 20		     22	        OUT 20H, AL         ; EOI
 301B 58		     23	        POP AX
 301C CF		     24	        IRET
			     25	        ORG 2000H
 2000 FA		     26	        CLI
 2001 B0 10		     27	        MOV AL, 10H
 2003 E6 24		     28	        OUT 24H, AL         ; INT0 -> vector 10h
 2005 B0 FE		     29	        MOV AL, 0FEH
 2007 E6 21		     30	        OUT 21H, AL         ; only INT0 unmasked
 2009 FB		     31	        STI
 200A 80 3E 00 10 02	     32	LAZO:   CMP CUENTA, 2
 200F 75 F9		     33	        JNZ LAZO
 2011 E4 21		     34	        IN AL, 21H
 2013 8A D8		     35	        MOV BL, AL
 2015 E4 22		     36	        IN AL, 22H
 2017 8A F8		     37	        MOV BH, AL
 2019 E4 23		     38	        IN AL, 23H
 201B 8A C8		     39	        MOV CL, AL
 201D CD 00		     40	        INT 0
			     41	        END


 S I M B O L O S:

 Nombre:	Tipo:		Valor:

 CUENTA  	Byte		1000h
 EN_RUT  	Byte		1001h
 RUT     	Label		3000h
 LAZO    	Label		200Ah
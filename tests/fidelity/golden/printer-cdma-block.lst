			      1	;; config: 3
			      2	;; paper: yes
			      3	;; timeout: 24
			      4	; The CDMA sends a block of memory to the printe
				r through the HAND (DREQ is
			      5	; the HAND's INT line); TC asks for INT3 at the 
				end.
			      6	        ORG 80
 0050 00 30		      7	        DW FINDMA
			      8	        ORG 1000H
 1000 50 4F 52 20 44 4D	      9	MSG     DB "POR DMA"
 1006 41
 1007 50		     10	FIN     DB ?
			     11	        ORG 3000H
 3000 B2 01		     12	FINDMA: MOV DL, 1
 3002 B0 20		     13	        MOV AL, 20H
 3004 E6 20		     14	        OUT 20H, AL
 3006 CF		     15	        IRET
			     16	        ORG 2000H
 2000 FA		     17	        CLI
 2001 B0 F7		     18	        MOV AL, 11110111B
 2003 E6 21		     19	        OUT 21H, AL
 2005 B0 14		     20	        MOV AL, 20
 2007 E6 27		     21	        OUT 27H, AL
 2009 B8 00 10		     22	        MOV AX, OFFSET MSG
 200C E6 50		     23	        OUT 50H, AL
 200E 8A C4		     24	        MOV AL, AH
 2010 E6 51		     25	        OUT 51H, AL
 2012 B0 07		     26	        MOV AL, OFFSET FIN - OFFSET MSG
 2014 E6 52		     27	        OUT 52H, AL
 2016 B0 00		     28	        MOV AL, 0
 2018 E6 53		     29	        OUT 53H, AL
 201A B0 0C		     30	        MOV AL, 00001100B
 201C E6 56		     31	        OUT 56H, AL
 201E E4 41		     32	        IN AL, 41H
 2020 80 C8 80		     33	        OR AL, 80H
 2023 E6 41		     34	        OUT 41H, AL
 2025 B2 00		     35	        MOV DL, 0
 2027 FB		     36	        STI
 2028 E6 57		     37	        OUT 57H, AL
 202A 80 FA 01		     38	ESPERA: CMP DL, 1
 202D 75 FB		     39	        JNZ ESPERA

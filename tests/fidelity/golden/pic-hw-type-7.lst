			      1	;; sim88: f10@1000
			      2	;; keys: 2:f10
			      3	;; timeout: 8
			      4	; A hardware interrupt with type 7 (INT0 of the 
				PIC -> vector 7, the one of
			      5	; INT 7): does the monitor write AL bytes from B
				X, or only run the vector?
			      6	        ORG 1000H
 1000 48 57 37		      7	TXT     DB "HW7"
			      8	        ORG 2000H
 2000 FA		      9	        CLI
 2001 B0 07		     10	        MOV AL, 7
 2003 E6 24		     11	        OUT 24H, AL
 2005 B0 FE		     12	        MOV AL, 0FEH
 2007 E6 21		     13	        OUT 21H, AL
 2009 BB 00 10		     14	        MOV BX, OFFSET TXT
 200C B0 03		     15	        MOV AL, 3
 200E FB		     16	        STI
 200F E9 0F 20		     17	LAZO:   JMP LAZO
			     18	        END



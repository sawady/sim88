 200E 80 E0 01		     15	        AND AL, 1
 2011 75 F9		     16	        JNZ POLL
 2013 8A 07		     17	        MOV AL, [BX]
 2015 E6 40		     18	        OUT 40H, AL
 2017 FF C3		     19	        INC BX
 2019 FE C9		     20	        DEC CL
 201B 75 EF		     21	        JNZ POLL
 201D F4		     22	        HLT

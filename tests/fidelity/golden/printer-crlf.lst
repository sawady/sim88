			      1	;; config: 2
			      2	;; paper: yes
			      3	;; timeout: 36
			      4	; CR, LF and CR LF on the paper.
			      5	        ORG 1000H
 1000 41 42 0D 43 44 0A	      6	MSG     DB "AB", 13, "CD", 10, "EF", 13, 10, "GH
				"
 1006 45 46 0D 0A 47 48
 100C 41		      7	FIN     DB ?
			      8	        ORG 2000H
 2000 E4 41		      9	        IN AL, 41H
 2002 80 E0 7F		     10	        AND AL, 7FH
 2005 E6 41		     11	        OUT 41H, AL
 2007 BB 00 10		     12	        MOV BX, OFFSET MSG
 200A B1 0C		     13	        MOV CL, OFFSET FIN - OFFSET MSG
